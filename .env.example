# Copy to .env and adjust. Every variable is optional; defaults are shown.

# Endpoints (default to local port-forwards into the Kind cluster)
RCA_LOKI_URL=http://localhost:3100
RCA_PROMETHEUS_URL=http://localhost:9090

# Kubernetes access (leave RCA_KUBE_CONTEXT unset to use your current kubectl context)
# RCA_KUBE_CONTEXT=kind-rca
RCA_KUBE_NAMESPACE=default

# Local vector database location
RCA_CHROMA_PATH=.chroma

# Notifications (leave unset to disable Slack alerts)
# RCA_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

RCA_LOG_LEVEL=INFO
